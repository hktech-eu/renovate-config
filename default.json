{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "No digests for Docker and GitHub Actions — x.y.z only",
      "matchManagers": ["docker", "github-actions"],
      "pinDigests": false
    },
    {
      "description": "Auto-merge minor, patch and pin updates when CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "automerge": true,
      "automergeType": "squash"
    },
    {
      "description": "Docker CI actions (docker/*) release together",
      "groupName": "docker GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^docker/"]
    }
  ]
}
